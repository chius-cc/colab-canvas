# colab-canvas environment configuration
# Generate a strong secret with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CANVAS_SECRET_KEY=replace-with-at-least-32-chars-random-secret-key
CANVAS_DATA_DIR=./data
CANVAS_HOST=127.0.0.1
CANVAS_PORT=8000

# Auth mode: hybrid | cloudflare | local
AUTH_MODE=hybrid
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
COOKIE_SECURE=false

# Storage backend: local | gdrive
STORAGE_BACKEND=local

# Quota & safety defaults
DEFAULT_DAILY_QUOTA=50
DEFAULT_MAX_QUEUED=2
MAX_BATCH_SIZE=4

# Streaming & background tasks
SSE_HEARTBEAT_SECONDS=20
OUTBOX_POLL_SECONDS=5

# Worker, Cost Guard & Colab Pool
WORKER_IDLE_TIMEOUT_SECONDS=900
WATCHDOG_IDLE_TIMEOUT_SECONDS=1200
WATCHDOG_MAX_LIFETIME_SECONDS=21600
WORKER_HEARTBEAT_INTERVAL_SECONDS=60
RECONCILE_INTERVAL_SECONDS=300
BALANCE_POLL_IDLE_SECONDS=600
BALANCE_POLL_ACTIVE_SECONDS=60
ALLOW_A100_FALLBACK=false
CIVITAI_API_TOKEN=
COLAB_ASSIGN_RETRIES=5

# Asset directories
WORKFLOWS_DIR=./workflows
SCRIPTS_DIR=./scripts
FRONTEND_DIST_DIR=./frontend/dist
